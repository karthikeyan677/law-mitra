# ==========================================
# Law Mithra - Environment Variables Template
# Phase 0: Foundation & Design System
# ==========================================

# ------------------------------------------
# Django Backend Settings
# ------------------------------------------
# Note: In production, generate a strong random secret key.
DJANGO_SECRET_KEY=django-insecure-law-mithra-phase0-local-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# Used by docker-compose and Django settings
POSTGRES_DB=lawmithra_db
POSTGRES_USER=lawmithra
POSTGRES_PASSWORD=lawmithra_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL format: postgres://USER:PASSWORD@HOST:PORT/NAME
# For Docker Compose, HOST is 'postgres'. For local dev without Docker, use 'localhost'.
DATABASE_URL=postgres://lawmithra:lawmithra_password@postgres:5432/lawmithra_db

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
# Comma-separated list of origins allowed to access the backend API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------
# Frontend Settings (Vite)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
